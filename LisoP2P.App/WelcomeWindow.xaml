<Window x:Class="LisoP2P.App.WelcomeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:conv="clr-namespace:LisoP2P.App.Converters"
        mc:Ignorable="d"
        Title="Bem-vindo ao LisoP2P"
        Height="430" Width="520"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        Background="#FF1B1B1B">
    <Window.Resources>
        <conv:EmptyToVisibilityConverter x:Key="EmptyToVisibilityConverter" />
    </Window.Resources>

    <StackPanel Margin="22">
        <TextBlock Text="Bem-vindo ao LisoP2P"
                   Foreground="White" FontSize="20" FontWeight="SemiBold" />
        <TextBlock Text="Conversa, tela e voz direto entre máquinas da mesma rede, sem servidor."
                   Foreground="Gray" FontSize="12" TextWrapping="Wrap" Margin="0,4,0,16" />

        <TextBlock Text="Como você quer aparecer para os outros?" Foreground="Gray" FontSize="11" />
        <TextBox x:Name="NicknameInput"
                 Text="{Binding Nickname, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                 MaxLength="24" Padding="6,5" Margin="0,4,0,0" FontSize="14" />
        <TextBlock Text="{Binding Error}" Foreground="#FFE06C75" FontSize="11" Margin="0,4,0,0"
                   TextWrapping="Wrap"
                   Visibility="{Binding Error, Converter={StaticResource EmptyToVisibilityConverter}}" />

        <Border Background="#FF232323" CornerRadius="6" Padding="12" Margin="0,16,0,0">
            <StackPanel>
                <TextBlock Text="Libere as portas no Firewall do Windows"
                           Foreground="#FFE5C07B" FontSize="12" FontWeight="SemiBold" />
                <TextBlock TextWrapping="Wrap" Foreground="Gray" FontSize="11" Margin="0,4,0,0"
                           Text="O app usa 47100/UDP (descoberta), 47101/TCP (sessão) e 47102/UDP (tela e voz). Na primeira execução o Windows pode perguntar se permite o acesso — escolha redes privadas. Sem isso os outros peers não aparecem na lista." />
            </StackPanel>
        </Border>

        <Border Background="#FF232323" CornerRadius="6" Padding="12" Margin="0,10,0,0">
            <StackPanel>
                <TextBlock Text="Seu fingerprint" Foreground="Gray" FontSize="11" />
                <TextBlock Text="{Binding Fingerprint}" Foreground="#FF9CDCFE" FontSize="12"
                           FontFamily="Consolas" TextWrapping="Wrap" Margin="0,4,0,0" />
                <TextBlock TextWrapping="Wrap" Foreground="Gray" FontSize="11" Margin="0,6,0,0"
                           Text="Ele identifica esta instalação. Compare com o que o outro lado vê ao conectar para ter certeza de que está falando com quem pensa." />
            </StackPanel>
        </Border>

        <Button Content="Começar" Command="{Binding StartCommand}"
                HorizontalAlignment="Right" Padding="24,7" Margin="0,18,0,0" IsDefault="True" />
    </StackPanel>
</Window>
