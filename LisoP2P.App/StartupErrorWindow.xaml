<Window x:Class="LisoP2P.App.StartupErrorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="LisoP2P — porta em uso"
        Height="330" Width="520"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        Background="#FF1B1B1B">
    <StackPanel Margin="22">
        <TextBlock Text="Não foi possível abrir as portas de rede"
                   Foreground="#FFE06C75" FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap" />
        <TextBlock TextWrapping="Wrap" Foreground="Gray" FontSize="12" Margin="0,6,0,0"
                   Text="Outro programa — provavelmente outra instância do LisoP2P — já está usando estas portas. Escolha outras em Configurações → Rede, ou feche o programa que as ocupa e tente de novo." />

        <Border Background="#FF232323" CornerRadius="6" Padding="12" Margin="0,14,0,0">
            <ItemsControl x:Name="ConflictList">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Foreground="#FFE5C07B" FontSize="12" FontFamily="Consolas" Margin="0,2">
                            <Run Text="{Binding Port, Mode=OneWay}" />
                            <Run Text="—" />
                            <Run Text="{Binding Role, Mode=OneWay}" />
                            <Run Text="(" /><Run Text="{Binding Detail, Mode=OneWay}" /><Run Text=")" />
                        </TextBlock>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </Border>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button Content="Abrir Configurações → Rede" Click="OpenSettings_Click" Padding="14,7" Margin="0,0,8,0" />
            <Button Content="Tentar de novo" Click="Retry_Click" Padding="14,7" Margin="0,0,8,0" IsDefault="True" />
            <Button Content="Sair" Click="Quit_Click" Padding="14,7" IsCancel="True" />
        </StackPanel>
    </StackPanel>
</Window>
