<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\LisoP2P.Core\LisoP2P.Core.csproj" />
    <ProjectReference Include="..\LisoP2P.Net\LisoP2P.Net.csproj" />
    <ProjectReference Include="..\LisoP2P.Media\LisoP2P.Media.csproj" />
    <ProjectReference Include="..\LisoP2P.Storage\LisoP2P.Storage.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.11" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <ApplicationIcon>lisop2p.ico</ApplicationIcon>
  </PropertyGroup>

  <!-- Shown in Explorer, in the Task Manager and in the exe's Details tab. Without these the
       published single file has blank metadata. -->
  <PropertyGroup>
    <AssemblyName>LisoP2P</AssemblyName>
    <Product>LisoP2P</Product>
    <AssemblyTitle>LisoP2P — chat, tela e voz na LAN</AssemblyTitle>
    <Description>Chat, tela e voz P2P na LAN, sem servidor central.</Description>
    <Company>LisoP2P</Company>
    <Authors>LisoP2P</Authors>
    <Copyright>Copyright © LisoP2P</Copyright>
    <Version>6.0.0</Version>
    <FileVersion>6.0.0.0</FileVersion>
    <AssemblyVersion>6.0.0.0</AssemblyVersion>
    <InformationalVersion>6.0.0</InformationalVersion>
  </PropertyGroup>

  <PropertyGroup>
    <!-- Trims localized resource assemblies of the dependencies out of the published output. -->
    <SatelliteResourceLanguages>pt-BR;en</SatelliteResourceLanguages>
  </PropertyGroup>

</Project>
