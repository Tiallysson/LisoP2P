<Window x:Class="LisoP2P.App.RoomWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:conv="clr-namespace:LisoP2P.App.Converters"
        mc:Ignorable="d"
        Title="Sala" Height="620" Width="960" MinWidth="760" MinHeight="480"
        Background="#FF1B1B1B">
    <Window.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" />
        <conv:BoolToAlignmentConverter x:Key="BoolToAlignmentConverter" />
        <conv:EmptyToVisibilityConverter x:Key="EmptyToVisibilityConverter" />
        <conv:NullToVisibilityConverter x:Key="NullToVisibilityConverter" />
    </Window.Resources>

    <Grid DataContext="{Binding ActiveRoom}" Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8">
            <TextBlock Text="{Binding RoomName}" Foreground="White" FontSize="16" FontWeight="SemiBold" />
            <TextBlock Text="{Binding MemberCountText}" Foreground="Gray" FontSize="12"
                       Margin="10,4,0,0" VerticalAlignment="Center" />
            <TextBlock Text="{Binding PresenterText}" Foreground="#FF61AFEF" FontSize="12"
                       Margin="14,4,0,0" VerticalAlignment="Center"
                       Visibility="{Binding PresenterText, Converter={StaticResource EmptyToVisibilityConverter}}" />
        </StackPanel>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="210" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="300" />
            </Grid.ColumnDefinitions>

            <!-- Members -->
            <DockPanel Grid.Column="0" Background="#FF232323" Margin="0,0,8,0">
                <TextBlock DockPanel.Dock="Top" Text="Membros" Foreground="Gray" FontSize="11" Margin="10,8" />
                <ListBox ItemsSource="{Binding Members}" Background="Transparent" BorderThickness="0"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal" Margin="2,4">
                                <Ellipse Width="10" Height="10" VerticalAlignment="Center" Margin="0,0,8,0">
                                    <Ellipse.Style>
                                        <Style TargetType="Ellipse">
                                            <Setter Property="Fill" Value="#FF3A3A3A" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsSpeaking}" Value="True">
                                                    <Setter Property="Fill" Value="#FF98C379" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Ellipse.Style>
                                </Ellipse>

                                <StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding Nickname}" Foreground="White" FontSize="12" />
                                        <TextBlock Text="🖥" Foreground="#FF61AFEF" FontSize="12" Margin="6,0,0,0"
                                                   ToolTip="Compartilhando a tela"
                                                   Visibility="{Binding IsSharingScreen, Converter={StaticResource BoolToVisibilityConverter}}" />
                                    </StackPanel>
                                    <TextBlock Text="{Binding StateText}" Foreground="Gray" FontSize="10"
                                               Visibility="{Binding StateText, Converter={StaticResource EmptyToVisibilityConverter}}" />
                                </StackPanel>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>

            <!-- Video -->
            <Grid Grid.Column="1" Background="Black" Margin="0,0,8,0">
                <Image Source="{Binding RemoteVideo}" Stretch="Uniform" />
                <TextBlock Text="Ninguém está compartilhando a tela"
                           Foreground="#FF5A5A5A" FontSize="13"
                           HorizontalAlignment="Center" VerticalAlignment="Center"
                           Visibility="{Binding RemoteVideo, Converter={StaticResource NullToVisibilityConverter}, ConverterParameter=Invert}" />
            </Grid>

            <!-- Chat -->
            <DockPanel Grid.Column="2" Background="#FF232323">
                <TextBlock DockPanel.Dock="Top" Text="Conversa da sala" Foreground="Gray" FontSize="11" Margin="10,8" />

                <Grid DockPanel.Dock="Bottom" Margin="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBox x:Name="MessageInput" Grid.Column="0"
                             Text="{Binding DraftText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             Padding="4,3" VerticalContentAlignment="Center"
                             PreviewKeyDown="MessageInput_PreviewKeyDown" />

                    <Button Grid.Column="1" Content="Enviar" Command="{Binding SendCommand}"
                            Margin="6,0,0,0" Padding="10,3" />
                </Grid>

                <ScrollViewer x:Name="MessageScroll" VerticalScrollBarVisibility="Auto" Margin="8,0">
                    <ItemsControl ItemsSource="{Binding Messages}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Margin="0,3" Padding="8,5" CornerRadius="6" MaxWidth="250"
                                        Background="#FF2E2E2E"
                                        HorizontalAlignment="{Binding IsOutgoing, Converter={StaticResource BoolToAlignmentConverter}}">
                                    <StackPanel>
                                        <TextBlock Text="{Binding SenderName}" Foreground="#FF61AFEF" FontSize="10"
                                                   FontWeight="SemiBold"
                                                   Visibility="{Binding ShowSender, Converter={StaticResource BoolToVisibilityConverter}}" />
                                        <TextBlock Text="{Binding Text}" Foreground="White" TextWrapping="Wrap" FontSize="12" />
                                        <TextBlock Text="{Binding TimeText}" Foreground="Gray" FontSize="9"
                                                   HorizontalAlignment="Right" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </DockPanel>
        </Grid>

        <!-- Controls -->
        <StackPanel Grid.Row="2" Margin="0,8,0,0">
            <StackPanel Orientation="Horizontal">
                <ComboBox ItemsSource="{Binding Monitors}" SelectedItem="{Binding SelectedMonitor, Mode=TwoWay}"
                          DisplayMemberPath="Description" Width="200" Margin="0,0,8,0"
                          Visibility="{Binding HasMultipleMonitors, Converter={StaticResource BoolToVisibilityConverter}}" />

                <Button Content="Compartilhar tela" Command="{Binding ShareScreenCommand}"
                        IsEnabled="{Binding CanShare}" Padding="10,4" Margin="0,0,6,0"
                        ToolTip="{Binding ShareBlockedReason}"
                        Visibility="{Binding IsSharing, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=Invert}" />

                <Button Content="Parar de compartilhar" Command="{Binding StopShareCommand}"
                        Padding="10,4" Margin="0,0,6,0"
                        Visibility="{Binding IsSharing, Converter={StaticResource BoolToVisibilityConverter}}" />

                <TextBlock Text="{Binding ShareBlockedReason}" Foreground="#FFE5C07B" FontSize="11"
                           VerticalAlignment="Center" Margin="4,0,12,0"
                           Visibility="{Binding ShareBlockedReason, Converter={StaticResource EmptyToVisibilityConverter}}" />

                <TextBlock Text="Falar:" Foreground="Gray" FontSize="11" VerticalAlignment="Center" Margin="8,0,4,0" />
                <ComboBox ItemsSource="{Binding PushToTalkOptions}" SelectedItem="{Binding PushToTalk, Mode=TwoWay}"
                          DisplayMemberPath="Label" Width="90" Margin="0,0,8,0" />

                <Ellipse Width="12" Height="12" VerticalAlignment="Center" Margin="0,0,6,0">
                    <Ellipse.Style>
                        <Style TargetType="Ellipse">
                            <Setter Property="Fill" Value="#FF3A3A3A" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsTransmittingVoice}" Value="True">
                                    <Setter Property="Fill" Value="#FFE06C75" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Ellipse.Style>
                </Ellipse>

                <CheckBox Content="Depuração" IsChecked="{Binding DebugMode, Mode=TwoWay}"
                          Foreground="Gray" VerticalAlignment="Center" Margin="8,0,0,0" />
            </StackPanel>

            <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                <TextBlock Text="Entrada:" Foreground="Gray" FontSize="11" VerticalAlignment="Center" Margin="0,0,4,0" />
                <ComboBox ItemsSource="{Binding InputDevices}" SelectedItem="{Binding SelectedInputDevice, Mode=TwoWay}"
                          DisplayMemberPath="Name" Width="200" Margin="0,0,10,0" />
                <TextBlock Text="Saída:" Foreground="Gray" FontSize="11" VerticalAlignment="Center" Margin="0,0,4,0" />
                <ComboBox ItemsSource="{Binding OutputDevices}" SelectedItem="{Binding SelectedOutputDevice, Mode=TwoWay}"
                          DisplayMemberPath="Name" Width="200" />
            </StackPanel>

            <TextBlock Text="{Binding VideoStatsText}" Foreground="Gray" FontSize="10" Margin="0,6,0,0"
                       Visibility="{Binding VideoStatsText, Converter={StaticResource EmptyToVisibilityConverter}}" />
            <TextBlock Text="{Binding VoiceStatsText}" Foreground="Gray" FontSize="10" Margin="0,2,0,0"
                       Visibility="{Binding VoiceStatsText, Converter={StaticResource EmptyToVisibilityConverter}}" />
        </StackPanel>
    </Grid>
</Window>
