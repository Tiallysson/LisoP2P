<Window x:Class="LisoP2P.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:LisoP2P.App"
        mc:Ignorable="d"
        Title="LisoP2P" Height="500" Width="820" MinWidth="600" MinHeight="360">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="240" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <DockPanel Grid.Column="0" Background="#FF1E1E1E">
                <StackPanel DockPanel.Dock="Top" Margin="12">
                    <TextBlock Text="{Binding Nickname}" FontWeight="Bold" Foreground="White" FontSize="16" />
                    <TextBlock Text="{Binding ShortId}" Foreground="Gray" FontSize="11" />
                </StackPanel>

                <StackPanel DockPanel.Dock="Bottom" Margin="12">
                    <TextBox Text="{Binding ManualConnectAddress, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,6" />
                    <Button Content="Conectar manualmente" Command="{Binding ConnectManuallyCommand}" />
                </StackPanel>

                <ItemsControl ItemsSource="{Binding Peers}" Margin="12,0">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Padding="6" Margin="0,0,0,4" Background="#FF2A2A2A" CornerRadius="4">
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse Width="10" Height="10" Fill="LimeGreen" VerticalAlignment="Center" Margin="0,0,8,0" />
                                    <StackPanel>
                                        <TextBlock Text="{Binding Nickname}" Foreground="White" FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding Address}" Foreground="Gray" FontSize="11" />
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </DockPanel>

            <Border Grid.Column="1" Background="#FF252526">
                <TextBlock Text="A conversa chega na fase 1"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           Foreground="Gray"
                           FontSize="16" />
            </Border>
        </Grid>

        <StatusBar Grid.Row="1">
            <StatusBarItem>
                <TextBlock Text="{Binding StatusText}" />
            </StatusBarItem>
        </StatusBar>
    </Grid>
</Window>
