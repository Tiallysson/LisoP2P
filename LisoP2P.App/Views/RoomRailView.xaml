<UserControl x:Class="LisoP2P.App.Views.RoomRailView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:conv="clr-namespace:LisoP2P.App.Converters"
             mc:Ignorable="d" d:DesignWidth="56">
    <UserControl.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolToVis" />
    </UserControl.Resources>

    <Border Background="{StaticResource Surface0}" TextElement.Foreground="{StaticResource TextPrimary}">
        <DockPanel>

            <StackPanel DockPanel.Dock="Bottom" Margin="0,6,0,8" HorizontalAlignment="Center">
                <Button Style="{StaticResource IconButton}"
                        Content="{StaticResource IconSettings}"
                        Command="{Binding OpenSettingsCommand}"
                        ToolTip="Configurações" />
            </StackPanel>

            <StackPanel DockPanel.Dock="Top">
                <Grid Height="48" Margin="0,8,0,0">
                    <Border Width="4" Height="24" CornerRadius="0,2,2,0"
                            HorizontalAlignment="Left" VerticalAlignment="Center"
                            Background="{StaticResource TextPrimary}"
                            Visibility="{Binding IsRoomSelected, Converter={StaticResource BoolToVis}, ConverterParameter=Invert}" />

                    <Button Style="{StaticResource IconButton}"
                            Width="40" Height="40" FontSize="17"
                            Content="{StaticResource IconDirectMessages}"
                            Command="{Binding ShowDirectMessagesCommand}"
                            ToolTip="Mensagens diretas" />
                </Grid>

                <Border Height="1" Width="28" Margin="0,2,0,6"
                        Background="{StaticResource BorderSubtle}" />
            </StackPanel>

            <StackPanel DockPanel.Dock="Bottom" HorizontalAlignment="Center" Margin="0,6,0,0">
                <Button Style="{StaticResource IconButton}"
                        Width="40" Height="40" FontSize="16"
                        Content="{StaticResource IconAdd}"
                        Command="{Binding StartCreateRoomCommand}"
                        ToolTip="Criar uma sala" />
            </StackPanel>

            <ListBox ItemsSource="{Binding Rooms}"
                     SelectedItem="{Binding SelectedRoom, Mode=TwoWay}"
                     Style="{StaticResource PlainListBox}"
                     Margin="0,0,0,0">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Padding" Value="0" />
                        <Setter Property="Margin" Value="0,2" />
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <Grid Height="48">
                                        <Border x:Name="Indicator" Width="4" Height="8" CornerRadius="0,2,2,0"
                                                HorizontalAlignment="Left" VerticalAlignment="Center"
                                                Background="{StaticResource TextPrimary}"
                                                Opacity="0" />
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Grid>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Indicator" Property="Opacity" Value="0.5" />
                                            <Setter TargetName="Indicator" Property="Height" Value="16" />
                                        </Trigger>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="Indicator" Property="Opacity" Value="1" />
                                            <Setter TargetName="Indicator" Property="Height" Value="24" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid ToolTip="{Binding Name}">
                            <Border Style="{StaticResource Avatar40}" Background="{StaticResource AccentBlue}">
                                <TextBlock Text="{Binding Initials}" Style="{StaticResource AvatarInitials}"
                                           FontSize="13" />
                            </Border>

                            <Border Width="10" Height="10" CornerRadius="5"
                                    Background="{StaticResource TextPrimary}"
                                    HorizontalAlignment="Left" VerticalAlignment="Bottom"
                                    Margin="-2,0,0,-1"
                                    Visibility="{Binding HasUnread, Converter={StaticResource BoolToVis}}" />
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </DockPanel>
    </Border>
</UserControl>
