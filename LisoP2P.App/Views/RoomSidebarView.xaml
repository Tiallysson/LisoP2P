<UserControl x:Class="LisoP2P.App.Views.RoomSidebarView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:conv="clr-namespace:LisoP2P.App.Converters"
             mc:Ignorable="d" d:DesignWidth="184">
    <UserControl.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolToVis" />
        <conv:EmptyToVisibilityConverter x:Key="EmptyToVis" />
        <conv:NicknameToInitialsConverter x:Key="ToInitials" />
        <conv:SessionStateToDotBrushConverter x:Key="StateToDot" />
    </UserControl.Resources>

    <Border Background="{StaticResource Surface1}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Height="48" Padding="12,0"
                    BorderBrush="{StaticResource BorderSubtle}" BorderThickness="0,0,0,1">
                <Grid>
                    <TextBlock Style="{StaticResource TextTitle}" VerticalAlignment="Center"
                               Text="{Binding ActiveRoom.RoomName}"
                               TextTrimming="CharacterEllipsis"
                               ToolTip="{Binding ActiveRoom.RoomName}"
                               Visibility="{Binding IsRoomSelected, Converter={StaticResource BoolToVis}}" />

                    <TextBlock Style="{StaticResource TextTitle}" VerticalAlignment="Center"
                               Text="Mensagens diretas"
                               TextTrimming="CharacterEllipsis"
                               Visibility="{Binding IsRoomSelected, Converter={StaticResource BoolToVis}, ConverterParameter=Invert}" />
                </Grid>
            </Border>

            <Grid Grid.Row="1">

                <DockPanel Visibility="{Binding IsRoomSelected, Converter={StaticResource BoolToVis}}"
                           Margin="8,10,8,8">

                    <StackPanel DockPanel.Dock="Top">
                        <TextBlock Text="CANAL DE TEXTO" Style="{StaticResource SectionHeader}" Margin="6,0,0,4" />

                        <Border Background="{StaticResource SurfaceSelected}" CornerRadius="4" Padding="6,5">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="#" Style="{StaticResource TextBody}"
                                           Foreground="{StaticResource TextMuted}" Margin="0,0,6,0" />
                                <TextBlock Text="geral" Style="{StaticResource TextBody}" />
                            </StackPanel>
                        </Border>

                        <StackPanel Orientation="Horizontal" Margin="6,14,0,4">
                            <TextBlock Text="VOZ — " Style="{StaticResource SectionHeader}" />
                            <TextBlock Text="{Binding ActiveRoom.VoiceMemberCount}" Style="{StaticResource SectionHeader}" />
                        </StackPanel>
                    </StackPanel>

                    <StackPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
                        <Button Style="{StaticResource FlatButton}" HorizontalAlignment="Stretch"
                                Content="Convidar peer selecionado"
                                Command="{Binding InviteSelectedPeerCommand}"
                                ToolTip="Convida o peer marcado em Mensagens diretas" />

                        <Button Style="{StaticResource DangerButton}" HorizontalAlignment="Stretch"
                                Content="Sair da sala"
                                Command="{Binding LeaveRoomCommand}"
                                Margin="0,2,0,0" />
                    </StackPanel>

                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding ActiveRoom.Members}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="Transparent" Padding="6,3" CornerRadius="4" Margin="0,1">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <Grid Grid.Column="0" Width="26" Height="26" Margin="0,0,8,0">
                                                <Border Style="{StaticResource Avatar22}">
                                                    <TextBlock Text="{Binding Initials}"
                                                               Style="{StaticResource AvatarInitials}" FontSize="10" />
                                                </Border>
                                                <Border Style="{StaticResource SpeakingRing}"
                                                        Width="26" Height="26" CornerRadius="13" />
                                            </Grid>

                                            <TextBlock Grid.Column="1" Text="{Binding DisplayName}"
                                                       Style="{StaticResource TextSmall}"
                                                       VerticalAlignment="Center"
                                                       TextTrimming="CharacterEllipsis"
                                                       ToolTip="{Binding DisplayName}" />

                                            <TextBlock Grid.Column="2" Style="{StaticResource IconGlyph}"
                                                       Text="{StaticResource IconScreenShare}"
                                                       Foreground="{StaticResource AccentBlue}"
                                                       Margin="6,0,0,0" FontSize="12"
                                                       ToolTip="Compartilhando a tela"
                                                       Visibility="{Binding IsSharingScreen, Converter={StaticResource BoolToVis}}" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </DockPanel>

                <DockPanel Visibility="{Binding IsRoomSelected, Converter={StaticResource BoolToVis}, ConverterParameter=Invert}"
                           Margin="8,10,8,8">

                    <StackPanel DockPanel.Dock="Top">
                        <Border Background="{StaticResource Surface2}" CornerRadius="6" Padding="8" Margin="0,0,0,10"
                                Visibility="{Binding IsCreatingRoom, Converter={StaticResource BoolToVis}}">
                            <StackPanel>
                                <TextBlock Text="NOVA SALA" Style="{StaticResource SectionHeader}" Margin="0,0,0,6" />

                                <TextBox Style="{StaticResource InputTextBox}"
                                         Text="{Binding NewRoomName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                         MaxLength="24" Padding="6,4">
                                    <TextBox.InputBindings>
                                        <KeyBinding Key="Return" Command="{Binding CreateRoomCommand}" />
                                    </TextBox.InputBindings>
                                </TextBox>

                                <Grid Margin="0,6,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <Button Grid.Column="0" Style="{StaticResource PrimaryButton}"
                                            Content="Criar" Command="{Binding CreateRoomCommand}" Margin="0,0,3,0" />

                                    <Button Grid.Column="1" Style="{StaticResource FlatButton}"
                                            Content="Cancelar" Command="{Binding CancelCreateRoomCommand}" Margin="3,0,0,0" />
                                </Grid>
                            </StackPanel>
                        </Border>

                        <TextBlock Text="PEERS NA REDE" Style="{StaticResource SectionHeader}" Margin="6,0,0,4" />
                    </StackPanel>

                    <StackPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
                        <TextBlock Text="CONECTAR MANUALMENTE" Style="{StaticResource SectionHeader}" Margin="6,0,0,4" />

                        <TextBox Style="{StaticResource InputTextBox}" Padding="6,4"
                                 Text="{Binding ManualConnectAddress, UpdateSourceTrigger=PropertyChanged}"
                                 ToolTip="Endereço IP do peer, usado quando o broadcast não chega">
                            <TextBox.InputBindings>
                                <KeyBinding Key="Return" Command="{Binding ConnectManuallyCommand}" />
                            </TextBox.InputBindings>
                        </TextBox>

                        <Button Style="{StaticResource FlatButton}" HorizontalAlignment="Stretch"
                                Content="Conectar" Command="{Binding ConnectManuallyCommand}" Margin="0,4,0,0" />

                        <TextBlock Text="{Binding RoomStatusText}" Style="{StaticResource TextTiny}"
                                   TextWrapping="Wrap" Margin="6,8,0,0" />
                    </StackPanel>

                    <ListBox ItemsSource="{Binding Peers}"
                             SelectedItem="{Binding SelectedPeer, Mode=TwoWay}"
                             Style="{StaticResource PlainListBox}">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <Border Grid.Column="0" Style="{StaticResource Avatar22}" Margin="0,0,8,0">
                                        <TextBlock Text="{Binding Nickname, Converter={StaticResource ToInitials}}"
                                                   Style="{StaticResource AvatarInitials}" FontSize="10" />
                                    </Border>

                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Nickname}" Style="{StaticResource TextSmall}"
                                                   Foreground="{StaticResource TextPrimary}"
                                                   TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding Address}" Style="{StaticResource TextTiny}"
                                                   TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Grid>

            <Border Grid.Row="2" Background="{StaticResource Surface0}" Padding="8,6">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Grid Grid.Column="0" Width="32" Height="32" Margin="0,0,8,0">
                        <Border Style="{StaticResource Avatar32}" Background="{StaticResource AccentBlue}">
                            <TextBlock Text="{Binding Nickname, Converter={StaticResource ToInitials}}"
                                       Style="{StaticResource AvatarInitials}" FontSize="12" />
                        </Border>

                        <Border Width="10" Height="10" CornerRadius="5"
                                HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                BorderBrush="{StaticResource Surface0}" BorderThickness="2"
                                Background="{Binding ActiveConversation.ConnectionState, Converter={StaticResource StateToDot}}" />
                    </Grid>

                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Nickname}" Style="{StaticResource TextSmall}"
                                   Foreground="{StaticResource TextPrimary}" FontWeight="SemiBold"
                                   TextTrimming="CharacterEllipsis"
                                   ToolTip="{Binding Fingerprint}" />

                        <TextBlock Style="{StaticResource TextTiny}"
                                   TextTrimming="CharacterEllipsis"
                                   Text="{Binding ActiveConversation.SubtitleText, FallbackValue='Ocioso', TargetNullValue='Ocioso'}" />
                    </StackPanel>

                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Command="{Binding ToggleMuteCommand}">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource ToggleIconButton}">
                                    <Setter Property="Content" Value="{StaticResource IconMicrophone}" />
                                    <Setter Property="ToolTip" Value="Silenciar o microfone" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsMuted}" Value="True">
                                            <Setter Property="Content" Value="{StaticResource IconMicrophoneOff}" />
                                            <Setter Property="Foreground" Value="{StaticResource StatusDanger}" />
                                            <Setter Property="ToolTip" Value="Reativar o microfone" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding ActiveConversation.IsTransmittingVoice}" Value="True">
                                            <Setter Property="Foreground" Value="{StaticResource StatusSuccess}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>

                        <Button Command="{Binding ToggleDeafenCommand}">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource ToggleIconButton}">
                                    <Setter Property="Content" Value="{StaticResource IconHeadphone}" />
                                    <Setter Property="ToolTip" Value="Silenciar a saída de áudio" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsDeafened}" Value="True">
                                            <Setter Property="Foreground" Value="{StaticResource StatusDanger}" />
                                            <Setter Property="ToolTip" Value="Voltar a ouvir" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>

                        <Button Style="{StaticResource ToggleIconButton}"
                                Content="{StaticResource IconSettings}"
                                Command="{Binding OpenSettingsCommand}"
                                ToolTip="Configurações" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Border>
</UserControl>
